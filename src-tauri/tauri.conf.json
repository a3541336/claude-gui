{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude GUI",
  "version": "0.1.0",
  "identifier": "tw.com.ruten.claudegui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude GUI",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RUU4RUY2QjcwQTVGN0MKUldSOFh3cTM5bzd1OVVnNkd6YTk5VFhoL3dlTWtSN3FtNVBBU09aVG9GamFWM2Q3LzMwWGc2THYK",
      "endpoints": [
        "https://github.com/a3541336/claude-gui/releases/latest/download/latest.json"
      ]
    }
  }
}
